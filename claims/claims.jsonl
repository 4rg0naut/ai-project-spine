{"auditable_trace": {"event_ids": ["evt_3508ffdc4b4742a985ab9153dd"], "hash_chain": ["vlO0SmkRItnnmct0pwvR3KDndSOL3EY0YNeeXY1Ii_g"]}, "claim": {"asserted_at": "2026-10-21T15:11:49Z", "claim_id": "clm_8893a4977df148649a135a264a", "claim_type": "factual", "context": {"spine": {"id": "R2-small-context", "kind": "rule", "true_asof": "2026-02"}}, "text": "AGENTS.md capped at N lines: small context files cut agent runtime/tokens; past ~150-200 instructions rules get ignored, not obeyed."}, "digest": {"algorithm": "sha256", "encoding": "base64url", "value": "YV2agCZb-lbZUSJdyKWhqI-i_-93F6Mj5NkNA4UT54U"}, "event_id": "evt_b12a102572b24a32ae1d1239ae", "event_time": "2026-10-21T15:11:49Z", "event_type": "claim.emitted", "evidence": [{"claim_ref": "clm_8893a4977df148649a135a264a", "evidence_id": "ev_e288707e004948a7800aa5cb78", "observed_at": "2026-10-21T15:11:49Z", "selector": {"fragment": "R2-small-context", "type": "uri_fragment"}, "source_ref": "src_b24feecfce71425c8d62164702", "support_type": "context_only"}], "producer": {"agent_id": "urn:tool:ai-project-spine", "agent_type": "service", "name": "ai-project-spine 0.3.1"}, "schema_url": "https://openclaims.org/schemas/openclaims/0.1/ClaimEvent.schema.json", "sources": [{"observed_at": "2026-10-21T15:11:49Z", "source_id": "src_b24feecfce71425c8d62164702", "uri": "https://arxiv.org/abs/2601.20404 ; https://www.humanlayer.dev/blog/writing-a-good-claude-md"}], "spec_version": "0.1.0"}
{"auditable_trace": {"event_ids": ["evt_b12a102572b24a32ae1d1239ae"], "hash_chain": ["YV2agCZb-lbZUSJdyKWhqI-i_-93F6Mj5NkNA4UT54U"]}, "claim": {"asserted_at": "2026-10-21T15:11:49Z", "claim_id": "clm_631a647b922944ef9e549c7ee6", "claim_type": "factual", "context": {"spine": {"id": "R3-staleness-gate", "kind": "rule", "true_asof": "2026-01/08"}}, "text": "Stale docs poison agents that re-read them every request; enforce size and pointer integrity, do not trust prose."}, "digest": {"algorithm": "sha256", "encoding": "base64url", "value": "vYOcoSDZzE7s0reJQEQtgpUzTpIqhA3jXgLZi5IHXpY"}, "event_id": "evt_65b4579b83e84ee295718a3631", "event_time": "2026-10-21T15:11:49Z", "event_type": "claim.emitted", "evidence": [{"claim_ref": "clm_631a647b922944ef9e549c7ee6", "evidence_id": "ev_3c05044b53a647b79c09b3546d", "observed_at": "2026-10-21T15:11:49Z", "selector": {"fragment": "R3-staleness-gate", "type": "uri_fragment"}, "source_ref": "src_0b5f5ce05aa34f609bf42d1a98", "support_type": "context_only"}], "producer": {"agent_id": "urn:tool:ai-project-spine", "agent_type": "service", "name": "ai-project-spine 0.3.1"}, "schema_url": "https://openclaims.org/schemas/openclaims/0.1/ClaimEvent.schema.json", "sources": [{"observed_at": "2026-10-21T15:11:49Z", "source_id": "src_0b5f5ce05aa34f609bf42d1a98", "uri": "https://www.aihero.dev/a-complete-guide-to-agents-md ; https://addyo.substack.com/p/audit-your-agent-files"}], "spec_version": "0.1.0"}
{"auditable_trace": {"event_ids": ["evt_65b4579b83e84ee295718a3631"], "hash_chain": ["vYOcoSDZzE7s0reJQEQtgpUzTpIqhA3jXgLZi5IHXpY"]}, "claim": {"asserted_at": "2026-10-21T15:11:49Z", "claim_id": "clm_33045aee7e994ccc8c3689bde7", "claim_type": "factual", "context": {"spine": {"id": "R4-plan-not-order", "kind": "rule", "true_asof": "2025-08 / 2011"}}, "text": "TODO items are hypotheses whose confidence decays when untouched: LLMs escalate commitment under prior-investment framing; written plans discharge open-loop load (human side)."}, "digest": {"algorithm": "sha256", "encoding": "base64url", "value": "haD6Ub49UhkFED_kWk3BY-NLaFvovu_eli-RoT7iswM"}, "event_id": "evt_1c90dca746204fc7abfc462110", "event_time": "2026-10-21T15:11:49Z", "event_type": "claim.emitted", "evidence": [{"claim_ref": "clm_33045aee7e994ccc8c3689bde7", "evidence_id": "ev_99784ec8730f4a2f95eabff37c", "observed_at": "2026-10-21T15:11:49Z", "selector": {"fragment": "R4-plan-not-order", "type": "uri_fragment"}, "source_ref": "src_f1238ce7ec584419848c3864c1", "support_type": "context_only"}], "producer": {"agent_id": "urn:tool:ai-project-spine", "agent_type": "service", "name": "ai-project-spine 0.3.1"}, "schema_url": "https://openclaims.org/schemas/openclaims/0.1/ClaimEvent.schema.json", "sources": [{"observed_at": "2026-10-21T15:11:49Z", "source_id": "src_f1238ce7ec584419848c3864c1", "uri": "https://arxiv.org/abs/2508.01545 ; https://pubmed.ncbi.nlm.nih.gov/21688924/"}], "spec_version": "0.1.0"}
